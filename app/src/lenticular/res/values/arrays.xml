<?xml version="1.0" encoding="utf-8"?>
<!--
    Two choices, the same as the Lume Pad build: the stream is side by side already, or it is
    2D and gets converted. The synced movie variant of the conversion is left out to keep the
    choice to those two.
-->
<resources>

    <string-array name="render_mode_names">
        <item>@string/render_mode_2d</item>
        <item>@string/render_mode_3d_sbs</item>
    </string-array>

    <string-array name="render_mode_values" translatable="false">
        <item>0</item>
        <item>1</item>
    </string-array>

</resources>
